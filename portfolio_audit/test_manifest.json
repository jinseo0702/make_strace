      "output": "portfolio_audit/bin/t04_open_close",
      "role": "case"
    },
    {
      "source": "portfolio_audit/tests/t05_lseek64.c",
      "output": "portfolio_audit/bin/t05_lseek64",
      "role": "case"
    },
    {
      "source": "portfolio_audit/tests/t06_newfstatat.c",
      "output": "portfolio_audit/bin/t06_newfstatat",
      "role": "case"
    },
    {
      "source": "portfolio_audit/tests/t07_memory.c",
      "output": "portfolio_audit/bin/t07_memory",
      "role": "case"
    },
    {
      "source": "portfolio_audit/tests/t08_getpid.c",
      "output": "portfolio_audit/bin/t08_getpid",
      "role": "case"
    },
    {
      "source": "portfolio_audit/tests/t09_execve.c",
      "output": "portfolio_audit/bin/t09_execve",
      "role": "case"
