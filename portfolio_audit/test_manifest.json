{
  "schema_version": 1,
  "repository_build": {
    "argv": [
      "make"
    ],
    "timeout_seconds": 120
  },
  "test_compiler": {
    "argv0": "gcc",
    "flags": [
      "-Wall",
      "-Wextra",
      "-Werror",
      "-O0",
      "-g"
    ],
    "timeout_seconds": 30
  },
  "case_timeout_seconds": 5,
  "engines": {
    "ft_strace": {
      "prefix_argv": [
        "./ft_strace"
      ]
    },
    "gnu": {
      "prefix_argv": [
        "strace"
      ]
    },
    "gnu_follow": {
      "prefix_argv": [
        "strace",
        "-f"
      ]
    }
  },
  "compile_targets": [
    {
      "source": "portfolio_audit/tests/t01_write_binary.c",
      "output": "portfolio_audit/bin/t01_write_binary",
      "role": "case"
    },
    {
